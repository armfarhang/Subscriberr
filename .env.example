# Subscriberr configuration (Spec §15). Copy to .env — never commit .env.

# Public base URL (OAuth redirect + email links).
# Dev: http://localhost:3000   Prod: https://subscriberr.mediaservers.org
BASE_URL=http://localhost:3000
# true when behind Nginx Proxy Manager (1 proxy hop), or a hop count (2 = Cloudflare proxy -> NPM)
TRUST_PROXY=false

# Google OAuth client (not needed in demo mode)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Encrypts stored tokens/keys and signs sessions. REQUIRED, >= 32 characters.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Store it separately (password manager) — backups do NOT include it.
APP_SECRET=change-me-change-me-change-me-change-me

TZ=America/Toronto
PORT=3000
LOG_LEVEL=info

# Data volume (DB, custom template packs, logos, import staging). Docker default: /data
DATA_DIR=./.data
# Backups volume — MUST be a different disk/share than DATA_DIR. Docker default: /backups
BACKUP_DIR=./.backups

# Comma-separated Google accounts that may always sign in. Recommended: when set, only these
# can become the Owner of a fresh install (otherwise the first person to sign in does).
ADMIN_EMAILS=

# File ownership on Unraid (used by the container entrypoint)
PUID=99
PGID=100

# --- Development / demo only -------------------------------------------------
# Both are refused unless BASE_URL is a localhost URL and NODE_ENV != production.
# Fake Google sign-in:
DEV_FAKE_LOGIN=true
# Demo data + fake Gmail / Plex / Jellyfin (no real services are contacted):
SEED_DEMO=true
